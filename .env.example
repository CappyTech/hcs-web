# .env.example
#
# Copy this file to ".env" and edit values for your machine:
#   - Windows (PowerShell): Copy-Item .env.example .env
#   - macOS/Linux/Git Bash: cp .env.example .env
#
# IMPORTANT:
# - Never commit your real .env file.
# - Keep this .env.example updated whenever you add new env vars.

# The port the Express server listens on.
PORT=80
START=2016

# ---------------------------------------------------------------------------
# Content API (hcs-app)
# ---------------------------------------------------------------------------
# Where the site's content is authored. Leave both blank and the site serves the
# built-in seed content in services/*Data.js — which is a supported state, not a
# broken one: it is what a fresh checkout runs on.
CONTENT_API_URL=https://app.heroncs.co.uk/api/web/content
CONTENT_API_TOKEN=

# How often to re-check for changes. Cheap: the API answers 304 when nothing
# has changed. Minimum 30 seconds.
CONTENT_REFRESH_SECONDS=120

# Shared secret for POST /revalidate, which hcs-app calls on publish so a change
# appears in seconds instead of at the next poll. Blank disables the endpoint.
CONTENT_REVALIDATE_SECRET=
