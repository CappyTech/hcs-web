<div class="bg-white">

  <!-- Hero section -->
  <div class="pt-16 pb-16 px-4 sm:px-6 lg:px-8">
    <div class="relative mx-auto max-w-7xl">
      <div class="flex flex-col lg:flex-row lg:items-center lg:gap-12">
        <div class="w-full lg:w-auto lg:max-w-lg mb-8 lg:mb-0">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-gray-900">External works, built to last.</h1>
          <p class="mt-4 text-lg sm:text-xl text-gray-700">From fencing and gates to paving, surfacing and estate improvements, we deliver the full range of external works for housing associations and councils across Merseyside and the North West &mdash; safely, tidily and to a standard that stands up to inspection.</p>
        </div>

        <div class="w-full lg:w-auto grid grid-cols-2 gap-4 sm:gap-6 lg:gap-8 auto-rows-max">
          <div class="col-span-1 h-40 sm:h-56 md:h-64 lg:h-80 overflow-hidden rounded-lg">
            <img src="/images/fence complete 5.jpeg" alt="Completed fencing on a housing estate" class="size-full object-cover" />
          </div>
          <div class="col-span-1 h-40 sm:h-56 md:h-64 lg:h-80 overflow-hidden rounded-lg">
            <img src="/images/fence 2.jpeg" alt="Fencing between residential properties" class="size-full object-cover" />
          </div>
          <div class="col-span-1 h-40 sm:h-56 md:h-64 lg:h-80 overflow-hidden rounded-lg">
            <img src="/images/gate 1.jpeg" alt="New access gate on a communal pathway" class="size-full object-cover" />
          </div>
          <div class="col-span-1 h-40 sm:h-56 md:h-64 lg:h-80 overflow-hidden rounded-lg">
            <img src="/images/fence 1.jpeg" alt="Boundary fencing installed along a street" class="size-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Process Section -->
  <div class="bg-white">
    <div class="mx-auto px-4 py-16 sm:px-6 lg:px-8 max-w-7xl">
      <div class="text-center mb-16">
        <h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">Our process</h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">From first survey to sign-off, we deliver external works with care for the site and the residents around it.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="flex flex-col items-center text-center">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-[#D9E9CF] text-primary font-bold text-2xl mb-4">1</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Survey &amp; quote</h3>
          <p class="text-gray-600">We assess the site, discuss requirements and provide a clear, honest proposal.</p>
        </div>
        <div class="flex flex-col items-center text-center">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-[#D9E9CF] text-primary font-bold text-2xl mb-4">2</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Plan &amp; schedule</h3>
          <p class="text-gray-600">We plan the works around residents and access, with materials and timeline agreed up front.</p>
        </div>
        <div class="flex flex-col items-center text-center">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-[#D9E9CF] text-primary font-bold text-2xl mb-4">3</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Deliver on site</h3>
          <p class="text-gray-600">Our team completes the works safely and to standard, keeping the site clean throughout.</p>
        </div>
        <div class="flex flex-col items-center text-center">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-[#D9E9CF] text-primary font-bold text-2xl mb-4">4</div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Sign-off &amp; support</h3>
          <p class="text-gray-600">We hand back a tidy site, remove waste responsibly and stand behind our work.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Services grid -->
  <div class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">What we do</h2>
        <p class="mt-4 text-lg text-gray-600">Our core external works services. Get in touch to discuss any of them for your estate.</p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <% services.forEach(function(service) { %>
          <% if (service.image) { %>
            <!-- Service with a dedicated page + photo: whole card is a link -->
            <a href="<%= service.href %>" class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-gray-900/5 transition hover:shadow-md">
              <img src="<%= service.image %>" alt="<%= service.imageAlt %>" class="h-48 w-full object-cover" />
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-lg font-semibold text-gray-900 group-hover:text-primary"><%= service.title %></h3>
                <p class="mt-2 flex-1 text-sm leading-6 text-gray-600"><%= service.description %></p>
                <span class="mt-4 text-sm font-semibold text-primary"><%= service.cta %> <span aria-hidden="true">&rarr;</span></span>
              </div>
            </a>
          <% } else { %>
            <!-- Service without a dedicated page yet: text card + enquire link -->
            <div class="flex flex-col rounded-2xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5">
              <h3 class="text-lg font-semibold text-gray-900"><%= service.title %></h3>
              <p class="mt-2 flex-1 text-sm leading-6 text-gray-600"><%= service.description %></p>
              <a href="<%= service.href %>" class="mt-4 text-sm font-semibold text-primary"><%= service.cta %> <span aria-hidden="true">&rarr;</span></a>
            </div>
          <% } %>
        <% }); %>
      </div>
      <!-- [TO SUPPLY] As dedicated per-service pages and photos become available,
           add `image`/`imageAlt` and a real `href` to the service in
           services/serviceService.js and it becomes a linked photo card. -->
    </div>
  </div>

  <!-- Our approach panel -->
  <section aria-labelledby="approach-heading">
    <div class="relative px-6 py-32 sm:px-12 sm:py-40 lg:px-16">
      <div class="absolute inset-0 overflow-hidden">
        <img src="/images/fence complete 5.jpeg" alt="Completed fencing on a housing estate" class="size-full object-cover" />
      </div>
      <div aria-hidden="true" class="absolute inset-0 bg-gray-900/60"></div>
      <div class="relative mx-auto flex max-w-3xl flex-col items-center text-center">
        <h2 id="approach-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Quality over quick margins</h2>
        <p class="mt-3 text-xl text-white">As a family-owned business we choose the right materials, vet our supply chain and take a long-term view &mdash; because on social housing, the work has to last and the residents have to live with it.</p>
        <a href="/about" class="mt-8 block w-full rounded-md border border-transparent bg-white px-8 py-3 text-base font-medium text-gray-900 hover:bg-gray-100 sm:w-auto">About us</a>
      </div>
    </div>
  </section>

  <!-- Case study section -->
  <section aria-labelledby="services-case-study-heading" class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
      <div class="sm:flex sm:items-baseline sm:justify-between">
        <h2 id="services-case-study-heading" class="text-2xl font-bold tracking-tight text-gray-900">See the work</h2>
        <a href="/studies" class="hidden text-sm font-semibold text-brand-charcoal hover:text-primary sm:block">
          Browse all case studies
          <span aria-hidden="true"> &rarr;</span>
        </a>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-y-10 sm:grid-cols-3 sm:gap-x-6 sm:gap-y-0 lg:gap-x-8">
        <div class="group relative">
          <img src="/images/fence after 4.jpeg" alt="Boundary fencing after replacement, level and cleanly finished" class="h-96 w-full rounded-lg object-cover group-hover:opacity-75 sm:aspect-2/3 sm:h-auto" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">
            <a href="/studies"><span class="absolute inset-0"></span>Estate fencing replacement</a>
          </h3>
        </div>
        <div class="group relative">
          <img src="/images/gate 2.jpeg" alt="New access gate installed on a communal pathway" class="h-96 w-full rounded-lg object-cover group-hover:opacity-75 sm:aspect-2/3 sm:h-auto" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">
            <a href="/studies"><span class="absolute inset-0"></span>Access gates &amp; boundary works</a>
          </h3>
        </div>
        <div class="group relative">
          <img src="/images/fence in process 2.jpeg" alt="HCS team installing fencing on site" class="h-96 w-full rounded-lg object-cover group-hover:opacity-75 sm:aspect-2/3 sm:h-auto" />
          <h3 class="mt-4 text-base font-semibold text-gray-900">
            <a href="/studies"><span class="absolute inset-0"></span>Fencing installation in progress</a>
          </h3>
        </div>
      </div>

      <div class="mt-8 sm:hidden">
        <a href="/studies" class="text-sm font-semibold text-primary hover:text-primary/80">Browse all case studies <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

</div>
