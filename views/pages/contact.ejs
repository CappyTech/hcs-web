<div class="relative isolate bg-white">
  <div class="mx-auto grid max-w-7xl grid-cols-1 lg:grid-cols-2">
    <div class="relative px-4 sm:px-6 pt-16 sm:pt-24 pb-16 sm:pb-20 lg:static lg:px-8 lg:py-32 xl:py-48">
      <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-lg">
        <div class="absolute inset-y-0 left-0 -z-10 w-full overflow-hidden bg-gray-100 ring-1 ring-gray-900/10 lg:w-1/2">
          <svg aria-hidden="true" class="absolute inset-0 size-full mask-[radial-gradient(100%_100%_at_top_right,white,transparent)] stroke-gray-200">
            <defs>
              <pattern id="contact-pattern" width="200" height="200" x="100%" y="-1" patternUnits="userSpaceOnUse">
                <path d="M130 200V.5M.5 .5H200" fill="none" />
              </pattern>
            </defs>
            <rect width="100%" height="100%" stroke-width="0" class="fill-white" />
            <svg x="100%" y="-1" class="overflow-visible fill-gray-50">
              <path d="M-470.5 0h201v201h-201Z" stroke-width="0" />
            </svg>
            <rect width="100%" height="100%" fill="url(#contact-pattern)" stroke-width="0" />
          </svg>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-pretty text-gray-900">Contact us</h1>
        <p class="mt-4 sm:mt-6 text-sm sm:text-base lg:text-lg/8 text-gray-600">
          Whether you need a quote for a single boundary or want to discuss an
          estate-wide programme, our team is ready to help. Call us, email us, or
          fill out the form and we'll be in touch as soon as possible.
        </p>

        <!-- Offices — data-driven (services/siteData.js → offices) -->
        <% offices.forEach(function(office) { %>
        <h2 class="mt-8 text-base font-semibold text-gray-900"><%= office.label %></h2>
        <dl class="mt-3 space-y-3 text-sm sm:text-base/7 text-gray-600">
          <div class="flex gap-x-4">
            <dt class="flex-none">
              <span class="sr-only">Address</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="h-6 w-6 text-gray-400">
                <path d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </dt>
            <dd>
              <%= site.name %><br />
              <%= office.address.line1 %>, <%= office.address.line2 %>,<br />
              <%= office.address.line3 %>, <%= office.address.postcode %>
            </dd>
          </div>
          <div class="flex gap-x-4">
            <dt class="flex-none">
              <span class="sr-only">Telephone</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="h-6 w-6 text-gray-400">
                <path d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </dt>
            <dd><a href="tel:<%= office.phone.replace(/\s+/g, '') %>" class="hover:text-gray-900"><%= office.phone %></a></dd>
          </div>
        </dl>
        <% }); %>

        <!-- Email -->
        <dl class="mt-6 space-y-3 text-sm sm:text-base/7 text-gray-600">
          <div class="flex gap-x-4">
            <dt class="flex-none">
              <span class="sr-only">Email</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="h-6 w-6 text-gray-400">
                <path d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </dt>
            <dd><a href="mailto:<%= site.email %>" class="hover:text-gray-900"><%= site.email %></a></dd>
          </div>
        </dl>

        <!-- Opening hours (data-driven) -->
        <% if (site.hours && site.hours.length) { %>
        <h2 class="mt-6 text-base font-semibold text-gray-900">Opening hours</h2>
        <dl class="mt-3 space-y-1 text-sm sm:text-base/7 text-gray-600">
          <% site.hours.forEach(function(row) { %>
          <div class="flex justify-between gap-x-6 max-w-xs">
            <dt><%= row.days %></dt>
            <dd class="text-gray-900"><%= row.time %></dd>
          </div>
          <% }); %>
        </dl>
        <% } %>

        <p class="mt-8 text-sm text-gray-500">
          All correspondence to <a href="mailto:<%= site.email %>" class="font-medium text-primary hover:underline"><%= site.email %></a>.
          <%= site.inbox.monitored %> <%= site.inbox.response %>
          If your enquiry is urgent, please call the relevant office.
        </p>
      </div>
    </div>

    <form action="/contact" method="POST" class="px-4 sm:px-6 pt-16 sm:pt-20 pb-16 sm:pb-24 lg:px-8 lg:py-32 xl:py-48">
      <div class="mx-auto max-w-xl lg:mr-0 lg:max-w-lg">

        <% if (typeof sent !== 'undefined' && sent) { %>
          <div role="status" class="mb-6 rounded-md bg-green-50 p-4 text-sm text-green-800 ring-1 ring-green-600/20">
            Thanks &mdash; your message has been sent. We'll be in touch shortly.
          </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
          <div role="alert" class="mb-6 rounded-md bg-red-50 p-4 text-sm text-red-800 ring-1 ring-red-600/20">
            <%= error %>
          </div>
        <% } %>

        <div class="grid grid-cols-1 gap-x-6 sm:gap-x-8 gap-y-4 sm:gap-y-6 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label for="name" class="block text-xs sm:text-sm/6 font-semibold text-gray-900">Name</label>
            <div class="mt-2">
              <input id="name" type="text" name="name" autocomplete="name" required value="<%= typeof form !== 'undefined' && form ? form.name : '' %>" class="block w-full rounded-md bg-white px-3 sm:px-3.5 py-2 text-sm sm:text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-primary" />
            </div>
          </div>
          <div class="sm:col-span-2">
            <label for="email" class="block text-xs sm:text-sm/6 font-semibold text-gray-900">Email</label>
            <div class="mt-2">
              <input id="email" type="email" name="email" autocomplete="email" required value="<%= typeof form !== 'undefined' && form ? form.email : '' %>" class="block w-full rounded-md bg-white px-3 sm:px-3.5 py-2 text-sm sm:text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-primary" />
            </div>
          </div>
          <div class="sm:col-span-2">
            <label for="phone" class="block text-xs sm:text-sm/6 font-semibold text-gray-900">Phone number <span class="font-normal text-gray-400">(optional)</span></label>
            <div class="mt-2">
              <input id="phone" type="tel" name="phone" autocomplete="tel" class="block w-full rounded-md bg-white px-3 sm:px-3.5 py-2 text-sm sm:text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-primary" />
            </div>
          </div>
          <div class="sm:col-span-2">
            <label for="message" class="block text-xs sm:text-sm/6 font-semibold text-gray-900">Message</label>
            <div class="mt-2">
              <textarea id="message" name="message" rows="4" required class="block w-full rounded-md bg-white px-3 sm:px-3.5 py-2 text-sm sm:text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-primary"><%= typeof form !== 'undefined' && form ? form.message : '' %></textarea>
            </div>
          </div>
        </div>
        <div class="mt-6 sm:mt-8 flex justify-end">
          <button type="submit" class="rounded-md bg-accent px-3 sm:px-3.5 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold text-white shadow-xs hover:bg-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition">
            Send message
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
